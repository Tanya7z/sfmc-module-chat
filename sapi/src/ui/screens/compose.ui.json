{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "chat.compose",
  "name": "chat.compose",
  "presentation": "form",
  "title": "发起私聊",
  "state": {
    "targetId": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    }
  },
  "load": {
    "players": {
      "service": "chat.ui.onlinePlayers",
      "input": {
        "playerId": "{{player.id}}"
      }
    }
  },
  "body": [
    {
      "id": "spacer",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "target",
      "type": "dropdown",
      "label": "目标玩家",
      "bind": "state.targetId",
      "options": {
        "source": "data.players.items",
        "as": "player",
        "value": "{{player.id}}",
        "label": "{{player.name}}"
      }
    },
    {
      "id": "spacer-2",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "content",
      "type": "textField",
      "label": "内容",
      "bind": "state.content"
    },
    {
      "id": "divider",
      "type": "divider"
    },
    {
      "id": "send",
      "type": "button",
      "label": "发送",
      "tone": "primary",
      "trigger": {
        "type": "action",
        "action": "send"
      }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": {
        "type": "back"
      }
    }
  ],
  "actions": {
    "send": {
      "call": {
        "service": "chat.ui.compose",
        "input": {
          "playerId": "{{player.id}}",
          "targetId": "{{state.targetId}}",
          "content": "{{state.content}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "已向 {{result.targetName}} 发送私聊",
          "tone": "success"
        },
        {
          "effect": "replace",
          "to": "chat.private"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "发送失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
