{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "chat.channels",
  "name": "chat.channels",
  "presentation": "reactive",
  "title": "聊天频道",
  "load": {
    "model": {
      "service": "chat.ui.channels",
      "input": {
        "playerId": "{{player.id}}"
      }
    }
  },
  "body": [
    {
      "id": "spacer",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "private",
      "type": "button",
      "label": "私聊",
      "trigger": {
        "type": "navigate",
        "to": "chat.private"
      },
      "tooltip": "说悄悄话...",
      "description": "说悄悄话..."
    },
    {
      "id": "manager",
      "type": "button",
      "label": "频道管理",
      "trigger": {
        "type": "navigate",
        "to": "chat.manager"
      }
    },
    {
      "id": "divider-2",
      "type": "divider"
    },
    {
      "id": "spacer-2",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "channels",
      "type": "each",
      "source": "data.model.items",
      "as": "channel",
      "template": [
        {
          "id": "channel-name",
          "type": "text",
          "text": "{{channel.title}}"
        },
        {
          "id": "spacer-4",
          "type": "spacer",
          "size": "small"
        },
        {
          "id": "channel-status",
          "type": "text",
          "text": "{{channel.status}}",
          "tone": "muted"
        },
        {
          "id": "spacer-5",
          "type": "spacer",
          "size": "small"
        },
        {
          "id": "subscribe",
          "type": "toggle",
          "label": "订阅",
          "bind": "channel.subscribed",
          "tooltip": "是否接收该频道消息",
          "disabledWhen": {
            "op": "not",
            "args": [
              {
                "ref": "channel.canUnsubscribe"
              }
            ]
          },
          "trigger": {
            "type": "action",
            "action": "setSubscribed",
            "input": {
              "channelId": "{{channel.id}}",
              "subscribed": "{{channel.subscribed}}"
            }
          }
        },
        {
          "id": "spacer-3",
          "type": "spacer",
          "size": "medium"
        }
      ],
      "empty": [
        {
          "id": "empty",
          "type": "text",
          "text": "暂无可用频道",
          "tone": "muted"
        }
      ]
    },
    {
      "id": "divider",
      "type": "divider"
    },
    {
      "id": "refresh",
      "type": "button",
      "label": "刷新",
      "trigger": {
        "type": "refresh"
      }
    },
    {
      "id": "close",
      "type": "button",
      "label": "关闭",
      "trigger": {
        "type": "close"
      }
    }
  ],
  "actions": {
    "setSubscribed": {
      "call": {
        "service": "chat.ui.setSubscribed",
        "input": {
          "playerId": "{{player.id}}"
        }
      },
      "onSuccess": [
        {
          "effect": "refresh"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "订阅更新失败：{{result.message}}",
          "tone": "danger"
        },
        {
          "effect": "refresh"
        }
      ]
    }
  }
}
