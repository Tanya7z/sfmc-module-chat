{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "chat.settings",
  "name": "chat.settings",
  "presentation": "form",
  "title": "频道设置",
  "params": {
    "channelId": {
      "type": "string",
      "required": true
    }
  },
  "state": {
    "name": {
      "type": "string",
      "default": "",
      "maxLength": 32
    },
    "prefix": {
      "type": "string",
      "default": "",
      "maxLength": 12
    },
    "slowMode": {
      "type": "string",
      "default": ""
    },
    "allowChat": {
      "type": "boolean",
      "default": true
    }
  },
  "load": {
    "channel": {
      "service": "chat.ui.channel",
      "input": {
        "playerId": "{{player.id}}",
        "channelId": "{{params.channelId}}"
      }
    }
  },
  "body": [
    {
      "id": "spacer",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "name",
      "type": "textField",
      "label": "频道名称",
      "bind": "state.name",
      "placeholder": "{{data.channel.name}}"
    },
    {
      "id": "spacer-2",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "prefix",
      "type": "textField",
      "label": "前缀",
      "bind": "state.prefix",
      "placeholder": "{{data.channel.prefix}}"
    },
    {
      "id": "spacer-3",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "slow-mode",
      "type": "textField",
      "label": "慢速模式-秒数",
      "bind": "state.slowMode",
      "description": "输入 0 可关闭",
      "placeholder": "{{data.channel.slowMode}}",
      "tooltip": "输入 0 可关闭"
    },
    {
      "id": "spacer-4",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "allow-chat",
      "type": "toggle",
      "label": "允许发言",
      "description": "关闭后仅频道主和管理员可发言",
      "tooltip": "关闭后仅频道主和管理员可发言",
      "bind": "state.allowChat",
      "trigger": {
        "type": "action",
        "action": "toggleAllowChat",
        "input": {
          "allowChat": "{{state.allowChat}}"
        }
      }
    },
    {
      "id": "divider",
      "type": "divider"
    },
    {
      "id": "text",
      "type": "text",
      "text": "危险操作",
      "tone": "danger"
    },
    {
      "id": "delete",
      "type": "button",
      "label": "删除频道",
      "tone": "danger",
      "visibleWhen": {
        "ref": "data.channel.canDelete"
      },
      "trigger": {
        "type": "action",
        "action": "delete"
      }
    },
    {
      "id": "divider-2",
      "type": "divider"
    },
    {
      "id": "save",
      "type": "button",
      "label": "保存修改",
      "tone": "primary",
      "trigger": {
        "type": "action",
        "action": "save"
      }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": {
        "type": "back"
      }
    }
  ],
  "actions": {
    "save": {
      "call": {
        "service": "chat.ui.saveChannel",
        "input": {
          "playerId": "{{player.id}}",
          "channelId": "{{params.channelId}}",
          "name": "{{state.name}}",
          "prefix": "{{state.prefix}}",
          "slowMode": "{{state.slowMode}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "频道设置已保存",
          "tone": "success"
        },
        {
          "effect": "refresh"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "保存失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "toggleAllowChat": {
      "call": {
        "service": "chat.ui.toggleAllowChat",
        "input": {
          "playerId": "{{player.id}}",
          "channelId": "{{params.channelId}}"
        }
      },
      "onSuccess": [
        {
          "effect": "refresh"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "更新失败：{{result.message}}",
          "tone": "danger"
        },
        {
          "effect": "refresh"
        }
      ]
    },
    "delete": {
      "confirm": {
        "title": "删除频道",
        "body": "确认删除频道“{{data.channel.name}}”吗？",
        "confirmText": "确认删除",
        "danger": true,
        "challenge": "我确认删除此频道"
      },
      "call": {
        "service": "chat.ui.deleteChannel",
        "input": {
          "playerId": "{{player.id}}",
          "channelId": "{{params.channelId}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "频道已删除",
          "tone": "success"
        },
        {
          "effect": "replace",
          "to": "chat.manager"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "删除失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
